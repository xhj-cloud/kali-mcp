# Kali MCP Server Configuration

# Transport mode: "stdio", "sse" (Cherry Studio), or "http" (Claude Desktop / streamable-http)
TRANSPORT=http

# HTTP server settings
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Bearer token for HTTP authentication (optional, leave empty for LAN)
AUTH_TOKEN=

# Default timeout for command execution (seconds)
DEFAULT_TIMEOUT=120

# Nuclei templates directory (optional). Auto-detected from ~/nuclei-templates,
# ~/.local/nuclei-templates, /root/... if unset. Set this when templates live
# somewhere non-standard, e.g. NUCLEI_TEMPLATES_DIR=/home/xhj/.local/nuclei-templates
NUCLEI_TEMPLATES_DIR=

# Enable pentest tools (nmap vuln, gobuster, nikto, enum4linux, whatweb, searchsploit, hydra)
# ⚠ Only enable if you're authorized to test the target network
PENTEST_ENABLED=false

# Enable active attack tools (sqlmap, wpscan, msfvenom, nc, responder, crackmapexec, airodump-ng, john)
# 🔴 EXTREME CAUTION — active exploitation, credential capture, payload generation
# Requires PENTEST_ENABLED=true first. Only enable on networks you OWN.
ATTACK_ENABLED=false

# --- system_patch_audit (vuls) — 🔴 ATTACK tool ---
# Patch/CVE audit over SSH (Windows KB/hotfix + OS build, or Linux package
# versions, compared against the vuls2 CVE DB). setup.sh installs vuls, the
# ssh shim, and the vuls2 DB dir when --tool-level full. The defaults below
# match setup.sh install locations; override only for a custom install.
VULS_BIN=/usr/local/bin/vuls
VULS_SSH_SHIM_DIR=/usr/local/lib/kali-mcp-vuls/bin
VULS2_DB_PATH=/var/lib/kali-mcp-vuls/vuls.db
